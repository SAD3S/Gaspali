# Copier en .env.local (non versionné) pour le développement.
# Sans ces deux valeurs, l'app fonctionne en mode local (pas de compte ni de partage).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Facultatif
EXPO_PUBLIC_CONTACT_EMAIL=          # contact affiché dans la politique de confidentialité et « À propos »
EXPO_PUBLIC_PRIVACY_URL=            # page web de la politique (ex. GitHub Pages : …/confidentialite)
EXPO_PUBLIC_SENTRY_DSN=             # rapports de plantage (sentry.io) ; vide = désactivé
